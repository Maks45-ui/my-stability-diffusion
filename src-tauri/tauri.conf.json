{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow",
  "version": "1.2.0",
  "identifier": "com.maks45ui.flow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flow",
        "width": 1280,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "backgroundColor": "#111317"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5RjgyRkIxQUZCNjBEMzkKUldRNURiYXZzUy80bWRoYm5SWFU2VkJRbEUyNm8xcUFYU3luSDM4WjdBczlEa2VRTmEwNjR0cXAK",
      "endpoints": [
        "https://github.com/Maks45-ui/my-stability-diffusion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
