{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flow",
  "version": "1.1.0",
  "identifier": "com.maks45ui.flow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Flow", "width": 1280, "height": 800, "minWidth": 920, "minHeight": 600, "backgroundColor": "#121820" }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
